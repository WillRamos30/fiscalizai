# Copie para .env e ajuste. NUNCA commite o .env.
# Em produção: PostgreSQL (troque provider no schema.prisma para "postgresql").
DATABASE_URL="file:./dev.db"

# Segredo de sessão JWT (>= 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-este-segredo-em-producao-0123456789abcdef0123456789"

# Senhas das contas de DEMONSTRAÇÃO (apenas desenvolvimento)
SEED_ADMIN_EMAIL="admin@avaliador.demo"
SEED_ADMIN_PASSWORD="Admin#Demo2026"
SEED_USER_EMAIL="usuario@avaliador.demo"
SEED_USER_PASSWORD="Usuario#Demo2026"

# URL pública (usada em sitemap/OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# CAPTCHA opcional (Cloudflare Turnstile). Vazio = desativado.
TURNSTILE_SECRET=""
